# Frontend: set this to the FastAPI service URL for production builds.
VITE_API_URL=https://moaz-elshazly.fastapicloud.dev

# Backend: set all values in the hosting provider's secret/environment settings.
PORT=8000
DATA_DIR=/var/lib/moaz-apps/data
UPLOADS_DIR=/var/lib/moaz-apps/uploads
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_NAME=Eng. Moaz El Shazly
ADMIN_EMAIL=admin@example.com
# Generate using: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
ALLOWED_ORIGINS=https://moazelshazly23.github.io,http://localhost:5173,http://127.0.0.1:5173
